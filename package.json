{
  "name": "mindvault",
  "private": true,
  "version": "0.1.0",
  "description": "MindVault — privacy-first smart notes for #BuildHybridAI 2026. Diary summaries and mood insights stay on-device (Gemini Nano via Firebase AI Logic); deep summaries go to the cloud only with explicit approval.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --port 4173 --strictPort",
    "test:db": "esbuild tests/db-test.ts --bundle --platform=node --format=cjs --outfile=/tmp/mv-db-test.cjs --log-level=warning && node -r fake-indexeddb/auto /tmp/mv-db-test.cjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
