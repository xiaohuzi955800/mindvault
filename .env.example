# MindVault environment configuration (phase 2).
#
# Copy this file to `.env` and fill in the values from the Firebase console.
# `.env` is git-ignored — NEVER commit real values. The Firebase web config
# values below identify the project (they are public-safe by design), but we
# still keep them out of the repo so the same code runs in mock mode anywhere.
#
# Phase 1 runs WITHOUT any of these: the mock AI provider is used and every
# note still works fully offline.

# Choose the AI provider: "mock" (default, simulated on-device + cloud) or
# "firebase" (real Firebase AI Logic — requires the values below).
VITE_AI_PROVIDER=mock

# Firebase web app config (Firebase console > Project settings > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA Enterprise site key (public-safe key, NOT a secret).
# The key must allow-list ONLY the production hosting domain — never add
# localhost to the production key. Local development uses a debug token
# instead (see README.md — debug tokens are NEVER committed).
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional: a fixed App Check debug token for local development (DEV builds
# only). When set, the app uses this exact token instead of letting the SDK
# generate one — register it once in the Firebase console (App Check > Apps
# > Manage debug tokens) and it works in every browser/profile. When unset,
# the SDK generates a token, prints it to the browser console, and persists
# it in that browser profile's IndexedDB. NEVER commit a debug token.
# VITE_APPCHECK_DEBUG_TOKEN=
